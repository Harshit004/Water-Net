# WATERNET — Environment Configuration Template
# Copy this file to: backend/config/database.php
# Fill in all values before deployment. NEVER commit real credentials to git.

# ── MySQL (cPanel) ───────────────────────────────────────
DB_HOST=localhost
DB_NAME=youruser_waternet
DB_USER=youruser_wn
DB_PASS=YourStrongPassword123!

# ── JWT ──────────────────────────────────────────────────
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace-with-64-char-random-hex-string
JWT_EXPIRY_HOURS=24

# ── IoT Device ───────────────────────────────────────────
# Shared key stored in firmware of all dispensers
DEVICE_SECRET=replace-with-strong-random-key

# ── Frontend ─────────────────────────────────────────────
FRONTEND_ORIGIN=https://yourdomain.com

# ── cPanel FTP (for deployment reference only) ───────────
FTP_HOST=ftp.yourdomain.com
FTP_USER=youruser
# FTP_PASS — do not store here; use your FTP client's password manager
